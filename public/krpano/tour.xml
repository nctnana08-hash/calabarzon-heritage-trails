    <image>
      <preview url="/panoramas/tiles/salon12k/preview.webp" />
      <sphere url="/panoramas/calabarzon-heritage-salon-12k.jpg" />
    </image>
    <hotspot name="hs_stairs_up_mezzanine" style="skin_stairsstyle" ath="0.0" atv="9.0" title="Climb Stairs to 2F Mezzanine Sky Gallery" onclick="loadscene(scene_sulyap_upstairs_mezzanine_12k, null, MERGE, BLEND(0.8));" />
