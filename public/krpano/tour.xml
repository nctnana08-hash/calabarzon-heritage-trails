  <!-- 1F Ground Floor: CALABARZON 12K Grand Atrium (12,000 x 6,000 Native Ray-Cast) -->
  <scene name="scene_sulyap_calabarzon_12k" title="1F Ground: CALABARZON 12K Grand Atrium (12,000 x 6,000)">
